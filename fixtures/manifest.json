  "producerCompatibilityReview": {
    "date": "2026-10-22",
    "scope": "Official stable/recent release listings, release-tag and default-branch export/serialization sources; source review only, no producer binaries or new producer exports tested",
    "findings": "Reviewed export definitions and serializer sources are byte-identical to the previous reference commits. Helion is an additional legacy import alias, not a new producer format revision.",
    "producers": [
      {
        "repository": "imchillin/Anamnesis",
        "latestRelease": "v7.57.0.3",
        "releaseCommit": "3d635757758ea9bd4e6d6d515cd6724bfabaa299",
