{
  "name": "xivcharakit",
  "version": "0.1.0-beta.4",
  "description": "Portable, local inspection of FFXIV character files",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashGalatine/XIVCharaKit.git",
    "directory": "packages/chara"
  },
  "homepage": "https://github.com/FlashGalatine/XIVCharaKit#readme",
  "bugs": {
    "url": "https://github.com/FlashGalatine/XIVCharaKit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./palettes": {
      "types": "./dist/palettes/index.d.ts",
      "import": "./dist/palettes.js"
    },
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance.js"
    },
    "./dyes": {
      "types": "./dist/dyes/index.d.ts",
      "import": "./dist/dyes.js"
    },
    "./xivapi": {
      "types": "./dist/xivapi/index.d.ts",
      "import": "./dist/xivapi.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json"
  }
}
